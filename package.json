{
  "name": "unicode-desktop",
  "version": "1.0.0",
  "description": "Unicode Lab: a desktop lab for programming coursework with Supabase, Monaco, and Judge0",
  "main": "./out/main/index.js",
  "author": "Unicode Lab",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rls": "node --env-file=.env scripts/rls-check.mjs",
    "start": "electron-vite preview",
    "dev": "concurrently -k -n desktop,admin -c blue,magenta \"npm run dev:desktop\" \"npm run dev:admin\"",
    "dev:desktop": "electron-vite dev",
    "dev:admin": "npm --prefix admin-web run dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "install-electron && electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:linux": "electron-vite build && electron-builder --linux"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@lezer/cpp": "^1.1.6",
    "@lezer/java": "^1.2.0",
    "@lezer/python": "^1.1.19",
    "@monaco-editor/react": "^4.7.0",
    "@supabase/supabase-js": "^2.119.0",
    "lucide-react": "^1.66.0",
    "pyright": "^1.1.414"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.1",
    "@electron-toolkit/eslint-config-ts": "^4.0.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.7",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "monaco-editor": "0.57.0",
    "prettier": "^3.9.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.1.1"
  }
}
