# Supabase project credentials — find them in your Supabase dashboard:
# Project Settings -> API
#
# The publishable key is safe to ship in the renderer: every table is
# protected by row-level security (see supabase/schema.sql).
#
# Copy this file to `.env` and fill in your values. Without it, the app
# runs in local-only mode (snapshots queue in localStorage until sign-in).

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Current Supabase projects expose a publishable key; older ones an anon
# key instead. The app accepts either name.
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# VITE_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY

# Judge0 is configured inside the professor dashboard (Test cases → Judge0),
# so no environment variables are required.
